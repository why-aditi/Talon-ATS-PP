# Copy to .env and adjust. .env is gitignored.
#
# Only DATABASE_URL is needed to run `pnpm db:migrate && pnpm db:seed` against
# the docker-compose stack. Everything else has a working local default and is
# listed here so the knobs are discoverable, not because you must set them.

# ── Database ────────────────────────────────────────────────────────────────
# Two URLs, two roles, and the difference is load-bearing.
#
# DATABASE_URL is the OWNER/migration role. It bypasses RLS, so migrations and
# the seed can write across tenants. Nothing that serves a request may use it.
#
# API_DATABASE_URL is the role the API connects as. It cannot bypass RLS, which
# is the backstop behind every tenant_id filter (spec 001 §5.3, §11b). They are
# deliberately not the same variable: sharing one name is how a service ends up
# running as the owner and quietly nullifying every policy.
DATABASE_URL=postgres://talon:talon@localhost:5432/talon
API_DATABASE_URL=postgres://talon_app:talon_app@localhost:5432/talon

# Password for the talon_app role, created by the migration runner. The local
# default is only handed out when the target host is loopback — migrating a
# remote database without setting this is refused rather than silently using a
# published credential (spec 001 §5.3).
# TALON_APP_PASSWORD=

# Connections per API process. One is reserved per in-flight request for the
# duration of its transaction, so this is the real concurrency ceiling.
# API_DB_POOL_MAX=10

# ── API ─────────────────────────────────────────────────────────────────────
# PORT=3001

# Access-token signing key. Local default is a published constant — worthless as
# a secret and obviously so. Required when NODE_ENV=production; the API refuses
# to start without it rather than signing with something guessable.
# TALON_JWT_SECRET=
# TALON_JWT_ISSUER=talon-local

# Password given to every seeded user by `pnpm --filter api seed:identities`.
# The seed writes `users` but not their credentials, so sign-in fails until that
# script runs. Dev fixture only — the data it belongs to is in the repo.
# SEED_PASSWORD=talon-dev-password

# ── Web ─────────────────────────────────────────────────────────────────────
# Mock mode is ON unless this is 'off', so the browser never reaches the API
# until you set it. Needed for the full sign-in path against a real API.
# NEXT_PUBLIC_MOCKS=off

# Where the browser reaches the API. Empty means same-origin.
# NEXT_PUBLIC_API_URL=
# Where the web app's route handlers reach the API, server-side.
# TALON_API_URL=http://localhost:3001
# Expected origin for same-origin checks; defaults to the request's own origin.
# APP_ORIGIN=http://localhost:3000

# ── Tests ───────────────────────────────────────────────────────────────────
# Suites never touch the database above: each creates and migrates its own.
# Overriding these is how you point them at a Testcontainers instance instead.
# TEST_DATABASE_NAME=talon_test
# TEST_DATABASE_URL=
# API_TEST_DATABASE_NAME=talon_api_test
# Set both to run apps/web's integration test against a live API.
# TALON_API_URL / TALON_API_TOKEN=<an access token from POST /v1/auth/sign-in>

# ── Local AWS (LocalStack: S3 + SQS) ────────────────────────────────────────
# Consumed by docker-compose and the AWS CLI only — no application code reads
# these yet. AWS_ENDPOINT_URL is the SDK's GLOBAL override, so exporting it
# alongside a real Cognito pool points sign-in at LocalStack and the failure
# reads as bad credentials. Prefer AWS_ENDPOINT_URL_S3 / _SQS when that lands.
REDIS_URL=redis://localhost:6379
# LocalStack (S3 + SQS). Consumed by docker-compose and the AWS CLI — no
# application code reads these yet.
#
# WARNING: AWS_ENDPOINT_URL is the SDK's GLOBAL endpoint override — it applies to
# every AWS service, Cognito included. Exporting this into a shell that also sets
# TALON_IDENTITY_PROVIDER=cognito points sign-in at LocalStack, which has no user
# pool, and the failure looks like a credentials problem rather than a routing
# one. Use AWS_ENDPOINT_URL_S3 / _SQS if you need both at once.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ── Identity provider (spec 002) ────────────────────────────────────────────
# `local` (the default, and the default on purpose) signs its own HS256 tokens
# and keeps password hashes in `local_identities`. A clean clone with no AWS
# account must come up and be signed into, so the AWS path is opt-in and never
# the fallback. Any value other than exactly `local` or `cognito` fails at boot
# rather than falling back — a deployment that thinks it is on AWS and is not is
# worse than one that refuses to start.
TALON_IDENTITY_PROVIDER=local
# Required when TALON_IDENTITY_PROVIDER=cognito; validated at boot, so a pool-id
# typo stops the process instead of turning every login into a 500. Region falls
# back to AWS_REGION, which ECS already sets. Credentials come from the SDK's own
# chain (task role in AWS, ambient profile locally) — never from a variable here.
# COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
# COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# COGNITO_REGION=us-east-1
#
# TALON_JWT_SECRET is REQUIRED alongside them. Cognito verifies credentials but
# Talon still mints the §6.2 bearer token, with this key -- so falling back to
# the published local constant next to a real user pool would let anyone forge a
# token for any tenant and any role. Boot refuses it.
# TALON_JWT_SECRET=
#
# Switching providers is an env change AND a re-provision:
#   pnpm --filter api seed:identities
# `users.external_id` is exclusive (migration 0004), so a person is provisioned
# against one provider at a time.

# Copy to .env and adjust. .env is gitignored.
#
# Only DATABASE_URL is needed to run `pnpm db:migrate && pnpm db:seed` against
# the docker-compose stack.
#
# STARTING THE API NEEDS MORE THAN THAT. Cognito is the only identity provider
# (spec 002 open question 1), so `pnpm dev` requires a real user pool, AWS
# credentials, and TALON_JWT_SECRET. The API refuses to boot without them rather
# than falling back to something that cannot authenticate anyone. See the
# identity-provider section below.

# ── Database ────────────────────────────────────────────────────────────────
# Two URLs, two roles, and the difference is load-bearing.
#
# DATABASE_URL is the OWNER/migration role. It bypasses RLS, so migrations and
# the seed can write across tenants. Nothing that serves a request may use it.
#
# API_DATABASE_URL is the role the API connects as. It cannot bypass RLS, which
# is the backstop behind every tenant_id filter (spec 001 §5.3, §11b). They are
# deliberately not the same variable: sharing one name is how a service ends up
# running as the owner and quietly nullifying every policy.
DATABASE_URL=postgres://talon:talon@localhost:5432/talon
API_DATABASE_URL=postgres://talon_app:talon_app@localhost:5432/talon

# Password for the talon_app role, created by the migration runner. The local
# default is only handed out when the target host is loopback — migrating a
# remote database without setting this is refused rather than silently using a
# published credential (spec 001 §5.3).
# TALON_APP_PASSWORD=

# Connections per API process. One is reserved per in-flight request for the
# duration of its transaction, so this is the real concurrency ceiling.
# API_DB_POOL_MAX=10

# ── API ─────────────────────────────────────────────────────────────────────
# PORT=3001

# Access-token signing key. REQUIRED, always — there is no local default any
# more. Cognito proves the credential; Talon still mints the §6.2 bearer token
# with this key, so a guessable value forges tokens for any tenant and any role.
# The old published constant `talon-local-development-signing-key` is refused
# explicitly, and whitespace counts as unset.
TALON_JWT_SECRET=
# TALON_JWT_ISSUER=talon-local

# Password given to every seeded user by `pnpm --filter api seed:identities`.
# `pnpm db:seed` writes `users` rows but not credentials — those live in the
# Cognito pool — so sign-in fails until that script runs against a real pool.
# Dev fixture only; the data it belongs to is in the repo.
# SEED_PASSWORD=talon-dev-password

# ── Web ─────────────────────────────────────────────────────────────────────
# Mock mode is ON unless this is 'off', so the browser never reaches the API
# until you set it. Needed for the full sign-in path against a real API.
# NEXT_PUBLIC_MOCKS=off

# Where the browser reaches the API. Empty means same-origin.
# NEXT_PUBLIC_API_URL=
# Where the web app's route handlers reach the API, server-side.
# TALON_API_URL=http://localhost:3001
# Expected origin for same-origin checks; defaults to the request's own origin.
# Also what the Google redirect_uri is built from — Cognito exact-matches it
# against the app client's callback list, so the two have to agree exactly.
# APP_ORIGIN=http://localhost:3000

# Google SSO (spec 004). All three are needed together: without them the route
# handlers 404 and the button stays disabled, which is the correct off state.
# The client id is the same app client the API validates tokens against.
# NEXT_PUBLIC_SSO_GOOGLE=on
# COGNITO_DOMAIN=https://talon-dev.auth.us-east-1.amazoncognito.com

# ── Tests ───────────────────────────────────────────────────────────────────
# Suites never touch the database above: each creates and migrates its own.
# Overriding these is how you point them at a Testcontainers instance instead.
# TEST_DATABASE_NAME=talon_test
# TEST_DATABASE_URL=
# API_TEST_DATABASE_NAME=talon_api_test
# Set both to run apps/web's integration test against a live API.
# TALON_API_URL / TALON_API_TOKEN=<an access token from POST /v1/auth/sign-in>

# ── Local AWS (LocalStack: S3 + SQS) ────────────────────────────────────────
# Consumed by docker-compose and the AWS CLI only — no application code reads
# these yet. AWS_ENDPOINT_URL is the SDK's GLOBAL override, so exporting it
# alongside a real Cognito pool points sign-in at LocalStack and the failure
# reads as bad credentials. Prefer AWS_ENDPOINT_URL_S3 / _SQS when that lands.
REDIS_URL=redis://localhost:6379
# LocalStack (S3 + SQS). Consumed by docker-compose and the AWS CLI — no
# application code reads these yet.
#
# WARNING: AWS_ENDPOINT_URL is the SDK's GLOBAL endpoint override — it applies to
# every AWS service, Cognito included. Exporting this into a shell that also sets
# TALON_IDENTITY_PROVIDER=cognito points sign-in at LocalStack, which has no user
# pool, and the failure looks like a credentials problem rather than a routing
# one. Use AWS_ENDPOINT_URL_S3 / _SQS if you need both at once.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
TALON_UPLOADS_BUCKET=talon-dev-quarantine
# Prefer the service-specific override so Cognito still reaches AWS.
AWS_ENDPOINT_URL_S3=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ── Identity provider (spec 002) ────────────────────────────────────────────
# Cognito, or nothing. `LocalIdentityProvider` was removed once open question 1
# was answered "Cognito only", so there is no provider to pick and no offline
# fallback: the API refuses to boot without a pool id, a client id and a region.
# That is deliberate — a deployment that silently comes up unable to
# authenticate anyone is worse than one that refuses to start.
#
# All three are validated at boot, so a pool-id typo stops the process instead
# of turning every login into a 500. Region falls back to AWS_REGION, which ECS
# already sets. Credentials come from the SDK's own chain (task role in AWS,
# ambient profile locally) — never from a variable here.
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_REGION=us-east-1
#
# TALON_IDENTITY_PROVIDER survives only as a tripwire: it may be `cognito` or
# unset, and anything else — `local` included — fails at boot. Ignoring a stale
# value would give an operator a Cognito deployment while their configuration
# said otherwise.
# TALON_IDENTITY_PROVIDER=cognito
#
# The API does not create Cognito users. `pnpm db:seed` writes `users` rows;
# credentials and subjects come from the pool, and the two are joined by
# `users.external_id`:
#   pnpm --filter api seed:identities
# `external_id` is exclusive (migration 0004), so a person has exactly one
# sign-in method and changing it is a re-provision, not a config flip.
#
# `pnpm test` needs NONE of this: apps/api/test/cognito-stub.ts is a fake pool at
# the network layer, and the suite is verified green with every AWS_* variable
# unset.

{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Consumed only by bundlers (apps/web via transpilePackages) and vitest, never
    // by node directly — so the source imports stay extensionless.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "declaration": false
  },
  "include": ["src"]
}

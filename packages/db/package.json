{
  "name": "@talon/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./dist/index.js" },
    "./migrate": { "types": "./src/migrate.ts", "default": "./dist/migrate.js" },
    "./seed": { "types": "./src/seed.ts", "default": "./dist/seed.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/migrate.ts up",
    "migrate:down": "tsx src/migrate.ts down",
    "seed": "tsx src/seed.ts",
    "test": "vitest run",
    "test:isolation": "vitest run test/rls.test.ts test/leak.test.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.4",
    "postgres": "^3.4.7",
    "uuidv7": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}

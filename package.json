{
  "name": "talon",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:routes": "pnpm --filter api test:routes",
    "test:isolation": "pnpm --filter api test:isolation",
    "db:migrate": "pnpm --filter @talon/db migrate",
    "db:seed": "pnpm --filter @talon/db seed",
    "tokens:build": "pnpm --filter @talon/tokens build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings 0",
    "gen:module": "node scripts/gen-module.mjs",
    "prepare": "husky",
    "e2e": "pnpm --filter e2e e2e"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "eslint": "^9.32.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^5.0.1",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "turbo": "^2.5.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0"
  }
}

{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:routes": "vitest run test/route-manifest.test.ts",
    "test:isolation": "vitest run test/isolation.test.ts test/rls-independence.test.ts",
    "seed:identities": "tsx src/scripts/seed-identities.ts",
    "link:federated": "tsx --env-file-if-exists=../../.env src/scripts/link-federated.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1106.0",
    "@talon/contracts": "workspace:*",
    "@talon/db": "workspace:*",
    "@talon/domain": "workspace:*",
    "awilix": "^12.0.5",
    "fastify": "^5.4.0",
    "postgres": "^3.4.7",
    "uuidv7": "^1.0.2"
  },
  "devDependencies": {
    "@talon/testing": "workspace:*",
    "@types/node": "^22.15.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
